# Chatwoot & SinHuellas Chat Environment Configuration Template

SECRET_KEY_BASE=generate_with_openssl_rand_hex_64
FRONTEND_URL=http://localhost:3000
PORT=3000
DEFAULT_LOCALE=es
FORCE_SSL=false
NODE_ENV=production
RAILS_ENV=production
RAILS_SERVE_STATIC_FILES=true
RAILS_MAX_THREADS=5
LOG_LEVEL=info

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DATABASE=chatwoot_production

# Redis Configuration
REDIS_URL=redis://redis:6379

# Storage Configuration
STORAGE_TYPE=local
ACTIVE_STORAGE_SERVICE=local

# Brand Configuration
INSTALLATION_NAME=SinHuellas Chat
BRAND_NAME=SinHuellas Chat
BRAND_URL=http://localhost:3000
WIDGET_BRAND_URL=http://localhost:3000
DISPLAY_MANIFEST=false
