# Chatwoot & SinHuellas Chat Environment Configuration Template

# Secret Key Base
# Genera una propia para cada servidor: openssl rand -hex 64
SECRET_KEY_BASE=cambia_esta_clave
FRONTEND_URL=http://localhost:3000
PORT=3000
DEFAULT_LOCALE=es
FORCE_SSL=false
NODE_ENV=production
RAILS_ENV=production
RAILS_SERVE_STATIC_FILES=true
RAILS_MAX_THREADS=5
LOG_LEVEL=info

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DATABASE=chatwoot_production

# Redis Configuration
REDIS_URL=redis://redis:6379

# Storage Configuration
STORAGE_TYPE=local
ACTIVE_STORAGE_SERVICE=local

# Brand Configuration
INSTALLATION_NAME=SinHuellas Chat
BRAND_NAME=SinHuellas Chat
BRAND_URL=http://localhost:3000
WIDGET_BRAND_URL=http://localhost:3000
DISPLAY_MANIFEST=false

# Mailer & SMTP Configuration (Optional)
# MAILER_SENDER_EMAIL=SinHuellas Chat <soporte@tudominio.com>
# SMTP_ADDRESS=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=tu_correo@gmail.com
# SMTP_PASSWORD=tu_contrasena_de_aplicacion
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS_AUTO=true
# SMTP_DOMAIN=gmail.com

# Lanzador de campañas: dirección pública de n8n (ej. https://n8n.tudominio.com); el lanzador llama a /webhook/campanas
# SH_N8N_URL_PUBLICA=
