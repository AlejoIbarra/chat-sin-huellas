<!DOCTYPE html>
<html>
  <head>
    <title><%= @global_config['INSTALLATION_NAME'] %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no, user-scalable=0"/>
    <% unless ChatwootApp.chatwoot_cloud? %>
      <meta name="robots" content="noindex">
    <% end %>
    <% if @global_config['DISPLAY_MANIFEST'] %>
      <meta name="theme-color" content="#2781F6">
      <link rel="icon" type="image/png" sizes="512x512" href="<%= @global_config['LOGO_THUMBNAIL'] %>">
    <% end %>
    <%= csrf_meta_tags %>
    <script>
      window.chatwootConfig = {
        hostURL: '<%= ENV.fetch('FRONTEND_URL', '') %>',
        helpCenterURL: '<%= ENV.fetch('HELPCENTER_URL', '') %>',
        fbAppId: '<%= @global_config['FB_APP_ID'] %>',
        tiktokAppId: '<%= @global_config['TIKTOK_APP_ID'] %>',
        whatsappAppId: '<%= @global_config['WHATSAPP_APP_ID'] %>',
        signupEnabled: '<%= @global_config['ENABLE_ACCOUNT_SIGNUP'] %>',
        isEnterprise: '<%= @global_config['IS_ENTERPRISE'] %>',
        enabledLanguages: <%= available_locales_with_name.to_json.html_safe %>,
        selectedLocale: '<%= I18n.locale %>'
      }
      window.globalConfig = <%= raw @global_config.merge("LOGO" => "#{@global_config["LOGO"]}?v=1", "LOGO_DARK" => "#{@global_config["LOGO_DARK"]}?v=1", "LOGO_THUMBNAIL" => "#{@global_config["LOGO_THUMBNAIL"]}?v=1").to_json %>
    </script>
    <%= vite_client_tag %>
    <%= vite_javascript_tag @application_pack %>
    <link rel="stylesheet" id="sinhuellas-custom-css" href="/custom.css?v=1791347814$(date +%s)<%= Time.now.to_i %>">
    <script>
      (function() {
        function ensureCustomCssLast() {
          var link = document.getElementById('sinhuellas-custom-css');
          if (link && document.head && document.head.lastElementChild !== link) document.head.appendChild(link);
        }
        function replaceTexts() {
          if (document.title && document.title.includes('Chatwoot')) document.title = document.title.replace(/Chatwoot/g, 'Chat sin huellas');
          var walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, null, false);
          var node;
          while (node = walker.nextNode()) {
            if (node.nodeValue.includes('Iniciar sesión en Chatwoot')) {
              node.nodeValue = node.nodeValue.replace(/Iniciar sesión en Chatwoot/g, 'Iniciar sesión en Chat sin huellas');
            }
          }
        }
        document.addEventListener('DOMContentLoaded', ensureCustomCssLast);
        window.addEventListener('load', ensureCustomCssLast);
        setTimeout(ensureCustomCssLast, 1000);
        setInterval(replaceTexts, 100);
      })();

      // Injection script for Massive Campaigns Express Button
      (function() {
        function manageCampaignButton() {
          const btnId = 'sh-mass-campaign-btn';
          let btn = document.getElementById(btnId);
          const isCampaignsPage = window.location.pathname.includes('/campaigns');
          
          if (isCampaignsPage && !btn) {
            btn = document.createElement('button');
            btn.id = btnId;
            btn.innerText = '⚡️ Envío Masivo Express';
            btn.style.cssText = 'position: fixed; top: 18px; right: 280px; z-index: 999999; background: #163f30; color: white; padding: 0.5rem 1.25rem; border-radius: 999px; font-weight: 700; cursor: pointer; border: 1px solid rgba(255,255,255,0.2); font-size: 14px; box-shadow: 0 10px 15px -3px rgba(22,63,48,0.4); transition: all 0.2s;'; btn.onmouseover = () => btn.style.transform = 'translateY(-2px)'; btn.onmouseout = () => btn.style.transform = 'translateY(0)';
            
            btn.onclick = () => {
              const csrfMeta = document.querySelector('meta[name="csrf-token"]');
              const csrfToken = csrfMeta ? csrfMeta.content : '';
              const match = window.location.pathname.match(/\/accounts\/(\d+)/);
              const accountId = match ? match[1] : '1';
              
              const overlay = document.createElement('div');
              overlay.id = 'sh-mass-campaign-overlay';
              overlay.style.cssText = 'position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 9999999; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(4px);';
              
              const modal = document.createElement('div');
              modal.style.cssText = 'width: 90%; max-width: 900px; height: 85vh; background: white; border-radius: 1rem; overflow: hidden; position: relative; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);';
              
              const closeBtn = document.createElement('button');
              closeBtn.innerHTML = '✕';
              closeBtn.style.cssText = 'position: absolute; top: 1rem; right: 1rem; background: #f1f5f9; border: none; border-radius: 50%; width: 32px; height: 32px; font-weight: bold; cursor: pointer; color: #475569; z-index: 10; display:flex; align-items:center; justify-content:center; font-size:16px;';
              closeBtn.onclick = () => document.body.removeChild(overlay);
              
              const iframe = document.createElement('iframe');
              iframe.src = '/campanas.html?v=1791308988&csrf=' + encodeURIComponent(csrfToken) + '&acc=' + accountId;
              iframe.style.cssText = 'width: 100%; height: 100%; border: none; background: transparent;';
              
              modal.appendChild(closeBtn);
              modal.appendChild(iframe);
              overlay.appendChild(modal);
              document.body.appendChild(overlay);
            };
            
            document.body.appendChild(btn);
          } else if (!isCampaignsPage && btn) {
            btn.remove();
          }
        }

        setInterval(manageCampaignButton, 500);
      })();
    </script>
  </head>
  <body class="text-slate-600">
    <div id="app"></div>
    <noscript id="noscript">This app works best with JavaScript enabled.</noscript>
    <%= yield %>
    <% if @dashboard_scripts.present? %>
      <%= @dashboard_scripts.html_safe %>
    <% end %>
  </body>
</html>
