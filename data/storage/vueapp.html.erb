<!DOCTYPE html>
<html>
  <head>
    <title>
      <%= @global_config['INSTALLATION_NAME'] %>
    </title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no, user-scalable=0"/>
    <% unless ChatwootApp.chatwoot_cloud? %>
      <meta name="robots" content="noindex">
    <% end %>
    <% if @global_config['DISPLAY_MANIFEST'] %>
      <meta name="msapplication-TileColor" content="#2781F6">
      <meta name="msapplication-TileImage" content="/ms-icon-144x144.png">
      <meta name="theme-color" content="#2781F6">
      <meta name="description" content="<%= @global_config['INSTALLATION_NAME'] %> is a customer support solution that helps companies engage customers over Messenger, Twitter, Telegram, WeChat, Whatsapp. Simply connect your channels and converse with your customers from a single place. Easily add new agents to your system and have them own and resolve conversations with customers. <%= @global_config['INSTALLATION_NAME'] %> also gives you real-time reports to measure your team's performance, canned responses to easily respond to frequently asked questions and private notes for agents to collaborate among themselves.">
      <% if ENV['IOS_APP_IDENTIFIER'].present? %>
        <meta name="apple-itunes-app" content='app-id=<%= ENV['IOS_APP_IDENTIFIER'] %>'>
      <% end %>
      <link rel="apple-touch-icon" sizes="57x57" href="/apple-icon-57x57.png">
      <link rel="apple-touch-icon" sizes="60x60" href="/apple-icon-60x60.png">
      <link rel="apple-touch-icon" sizes="72x72" href="/apple-icon-72x72.png">
      <link rel="apple-touch-icon" sizes="76x76" href="/apple-icon-76x76.png">
      <link rel="apple-touch-icon" sizes="114x114" href="/apple-icon-114x114.png">
      <link rel="apple-touch-icon" sizes="120x120" href="/apple-icon-120x120.png">
      <link rel="apple-touch-icon" sizes="144x144" href="/apple-icon-144x144.png">
      <link rel="apple-touch-icon" sizes="152x152" href="/apple-icon-152x152.png">
      <link rel="apple-touch-icon" sizes="180x180" href="/apple-icon-180x180.png">
      <link rel="icon" type="image/png" sizes="192x192"  href="/android-icon-192x192.png">
      <link class="favicon" rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
      <link class="favicon" rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
      <link class="favicon" rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
      <link rel="manifest" href="/manifest.json">
    <% end %>
    <link rel="icon" type="image/png" sizes="512x512" href="<%= @global_config['LOGO_THUMBNAIL'] %>">
    <%= csrf_meta_tags %>
    <script>
      window.chatwootConfig = {
        hostURL: '<%= ENV.fetch('FRONTEND_URL', '') %>',
        helpCenterURL: '<%= ENV.fetch('HELPCENTER_URL', '') %>',
        fbAppId: '<%= @global_config['FB_APP_ID'] %>',
        instagramAppId: '<%= @global_config['INSTAGRAM_APP_ID'] %>',
        tiktokAppId: '<%= @global_config['TIKTOK_APP_ID'] %>',
        googleOAuthClientId: '<%= ENV.fetch('GOOGLE_OAUTH_CLIENT_ID', nil) %>',
        googleOAuthCallbackUrl: '<%= ENV.fetch('GOOGLE_OAUTH_CALLBACK_URL', nil) %>',
        allowedLoginMethods: <%= @global_config['ALLOWED_LOGIN_METHODS'].to_json.html_safe %>,
        fbApiVersion: '<%= @global_config['FACEBOOK_API_VERSION'] %>',
        whatsappAppId: '<%= @global_config['WHATSAPP_APP_ID'] %>',
        whatsappConfigurationId: '<%= @global_config['WHATSAPP_CONFIGURATION_ID'] %>',
        whatsappApiVersion: '<%= @global_config['WHATSAPP_API_VERSION'] %>',
        signupEnabled: '<%= @global_config['ENABLE_ACCOUNT_SIGNUP'] %>',
        isEnterprise: '<%= @global_config['IS_ENTERPRISE'] %>',
        isMfaEnabled: '<%= Chatwoot.mfa_enabled? %>',
        <% if @global_config['IS_ENTERPRISE'] %>
        enterprisePlanName: '<%= @global_config['INSTALLATION_PRICING_PLAN'] %>',
        <% end %>
        <% if @global_config['VAPID_PUBLIC_KEY'] %>
        vapidPublicKey: new Uint8Array(<%= Base64.urlsafe_decode64(@global_config['VAPID_PUBLIC_KEY']).bytes %>),
        <% end %>
        enabledLanguages: <%= available_locales_with_name.to_json.html_safe %>,
        helpUrls: <%= feature_help_urls.to_json.html_safe %>,
        inboxEventsEnabled: '<%= ENV['ENABLE_INBOX_EVENTS'].present? %>',
        selectedLocale: '<%= I18n.locale %>'
      }
      window.globalConfig = <%= raw @global_config.merge("LOGO" => "#{@global_config["LOGO"]}?v=1", "LOGO_DARK" => "#{@global_config["LOGO_DARK"]}?v=1", "LOGO_THUMBNAIL" => "#{@global_config["LOGO_THUMBNAIL"]}?v=1").to_json %>
      window.browserConfig = {
        browser_name: '<%= browser.name %>',
      }
      window.errorLoggingConfig = '<%= ENV.fetch('SENTRY_FRONTEND_DSN', '') || ENV.fetch('SENTRY_DSN', '') %>'
    </script>
    <% if @global_config['CLOUD_ANALYTICS_TOKEN'].present? %>
    <script>
      window.analyticsConfig = {
        token: '<%= @global_config['CLOUD_ANALYTICS_TOKEN'] %>',
      }
    </script>
    <% end %>
    <%= vite_client_tag %>
    <%= vite_javascript_tag @application_pack %>
    <%# custom.css se pide con una versión sacada de su contenido: Chatwoot sirve /public con caché de un año %>
    <link rel="stylesheet" id="sinhuellas-custom-css" href="/custom.css?v=<%= (Digest::MD5.file(Rails.public_path.join('custom.css')).hexdigest[0, 12] rescue '0') %>">
    <script>
      // Apariencia de Sin Huellas: custom.css de último y los textos propios. Lo visual vive en custom.css; aquí solo se crean elementos y clases.
      (function() {
        // custom.css gana a Chatwoot por orden, sin !important: va de último aunque Chatwoot agregue sus hojas al cambiar de pantalla
        const ponerAlFinal = () => {
          const hoja = document.getElementById('sinhuellas-custom-css');
          if (hoja && hoja !== document.head.lastElementChild) document.head.appendChild(hoja);
        };
        new MutationObserver(ponerAlFinal).observe(document.head, { childList: true });
        ponerAlFinal();

        // Plantillas de WhatsApp: en Meta tienen nombres técnicos que no se pueden cambiar (el asistente las envía por ese nombre). En Ajustes →
        // Plantillas se ven con un nombre claro y, al abrir una, para qué sirve y quién la envía; el lanzador (campanas.html) usa esta misma
        // lista. Las que no están aquí (las que el bufete cree en Meta) se ven con su nombre de Meta.
        const PLANTILLAS = window.shPlantillas = {
          pago_verificado_elige_horario: { titulo: 'Pago verificado: elegir la fecha', quien: 'asistente', para: 'La envía el asistente cuando el equipo verifica el pago y la persona lleva más de 24 horas sin escribir. Con el botón, ella elige la fecha de su cita.' },
          datos_pendientes: { titulo: 'Faltan los datos de la cita', quien: 'asistente', para: 'La envía el asistente cuando la persona aún no llena el formulario de su cita y lleva más de 24 horas sin escribir. Con el botón, recibe el enlace.' },
          recordatorio_cita: { titulo: 'Recordatorio de la cita', quien: 'asistente', para: 'La envía el asistente antes de cada cita, con la fecha, el lugar o el enlace de la videollamada y el código. También confirma la cita que el equipo agendó a mano, si la persona lleva más de 24 horas sin escribir.' },
          seguimiento_asesoria: { titulo: 'Recordatorio para tomar la asesoría', quien: 'asistente', para: 'La envía el asistente una sola vez, el día en que la persona dijo que pagaría, si no llegó el comprobante. Solo a quien aceptó recibir promociones.' },
          seguimiento_solicitud: { titulo: 'Retomar una conversación', quien: 'equipo', para: 'La usa el equipo para volver a escribirle a alguien que lleva más de 24 horas sin escribir, con el botón «Enviar plantilla» de la conversación. Lleva la fecha de su solicitud.' },
          documento_asesoria: { titulo: 'Enviar el documento de la asesoría', quien: 'equipo', para: 'La usa el equipo para enviarle a la persona el PDF de su asesoría, con el botón «Enviar plantilla» de la conversación. Lleva el código de la cita.' },
        };
        // Chatwoot muestra el estado y la categoría como los manda Meta, en inglés
        const EN_ESPANOL = { Approved: 'Aprobada', Rejected: 'Rechazada', Pending: 'En revisión', Paused: 'Pausada', Disabled: 'Desactivada', Utility: 'Utilidad', Authentication: 'Autenticación' };
        const SUBTITULO = 'Consulta cómo aparece esta plantilla en WhatsApp.';
        const TITULOS = new Set(Object.values(PLANTILLAS).map((p) => p.titulo));
        function nombrarPlantilla(nodo) {
          if (!window.location.pathname.includes('/settings/templates')) return;
          const valor = nodo.nodeValue.trim();
          if (EN_ESPANOL[valor]) { nodo.nodeValue = EN_ESPANOL[valor]; return; }
          if (TITULOS.has(valor)) return; // ya tiene su nombre claro (el cambio de texto vuelve a pasar por aquí)
          const p = PLANTILLAS[valor];
          const el = nodo.parentElement;
          // en el panel de una plantilla, debajo del título va para qué sirve (o el texto de Chatwoot si no es una de las nuestras)
          if (el?.matches('aside header h3') && el.nextElementSibling) el.nextElementSibling.textContent = p ? `${p.para} En Meta se llama ${valor}.` : SUBTITULO;
          if (!p) return;
          nodo.nodeValue = p.titulo;
          el?.setAttribute('title', `${p.para} En Meta se llama ${valor}.`);
        }

        // Textos: el nombre del producto, el estado «Pendientes» (es donde atiende el bot) y las plantillas. Un observador revisa solo lo que
        // cambia (recorrer toda la página cada pocos milisegundos gasta batería en el celular).
        function revisarTexto(nodo) {
          const valor = nodo.nodeValue;
          if (valor.includes('Iniciar sesión en Chatwoot')) nodo.nodeValue = valor.replace(/Iniciar sesión en Chatwoot/g, 'Iniciar sesión en Chat sin huellas');
          if (valor.trim() === 'Pendientes') nodo.nodeValue = 'Bot atendiendo';
          // Chatwoot pone en mayúscula cada palabra de la etiqueta de estado («Bot Atendiendo»); normal-case (Tailwind de Chatwoot) lo deja tal cual
          if (nodo.nodeValue === 'Bot atendiendo') nodo.parentElement?.classList.add('normal-case');
          nombrarPlantilla(nodo);
        }
        function revisarArbol(raiz) {
          const recorrido = document.createTreeWalker(raiz, NodeFilter.SHOW_TEXT);
          for (let nodo = recorrido.nextNode(); nodo; nodo = recorrido.nextNode()) revisarTexto(nodo);
        }
        function iniciar() {
          revisarArbol(document.body);
          new MutationObserver((cambios) => {
            for (const cambio of cambios) {
              if (cambio.type === 'characterData') revisarTexto(cambio.target);
              else cambio.addedNodes.forEach((n) => (n.nodeType === Node.TEXT_NODE ? revisarTexto(n) : n.nodeType === Node.ELEMENT_NODE && revisarArbol(n)));
            }
          }).observe(document.body, { childList: true, subtree: true, characterData: true });
        }
        if (document.body) iniciar(); else document.addEventListener('DOMContentLoaded', iniciar);
        setInterval(() => { if (document.title.includes('Chatwoot')) document.title = document.title.replace(/Chatwoot/g, 'Chat sin huellas'); }, 1000);
      })();

      // Modo claro u oscuro. Chatwoot guarda la elección de cada persona en su navegador (color_scheme: light, dark o auto) y en «auto» copia
      // el modo del equipo. Aquí «auto» también sigue el sol de Pasto, la sede principal: oscuro del atardecer al amanecer. Si el equipo está
      // en modo oscuro se respeta, y si la persona elige Claro u Oscuro (con el botón de la barra lateral o en Cambiar apariencia), manda su
      // elección. Chatwoot sigue aplicando el tema como siempre: solo se le contesta con el sol incluido cuando pregunta si está oscuro.
      (function() {
        const PASTO = { lat: 1.2136, lon: -77.2811 };
        /** ¿Es de noche en Pasto? Cálculo solar de la NOAA, con la refracción del horizonte. En Colombia el amanecer y el atardecer caen el
         *  mismo día UTC, así que antes del uno o después del otro es de noche. */
        function deNoche(ahora = new Date()) {
          const rad = Math.PI / 180;
          const g = 2 * Math.PI / 365 * ((ahora - Date.UTC(ahora.getUTCFullYear(), 0, 1)) / 864e5);
          const ecuacion = 229.18 * (0.000075 + 0.001868 * Math.cos(g) - 0.032077 * Math.sin(g) - 0.014615 * Math.cos(2 * g) - 0.040849 * Math.sin(2 * g));
          const declinacion = 0.006918 - 0.399912 * Math.cos(g) + 0.070257 * Math.sin(g) - 0.006758 * Math.cos(2 * g) + 0.000907 * Math.sin(2 * g) - 0.002697 * Math.cos(3 * g) + 0.00148 * Math.sin(3 * g);
          const mitad = 4 * Math.acos(Math.cos(90.833 * rad) / (Math.cos(PASTO.lat * rad) * Math.cos(declinacion)) - Math.tan(PASTO.lat * rad) * Math.tan(declinacion)) / rad;
          const mediodia = 720 - 4 * PASTO.lon - ecuacion; // en minutos desde la medianoche UTC
          const minuto = ahora.getUTCHours() * 60 + ahora.getUTCMinutes();
          return minuto < mediodia - mitad || minuto > mediodia + mitad;
        }
        const original = window.matchMedia.bind(window);
        const equipo = original('(prefers-color-scheme: dark)');
        const afueraOscuro = () => equipo.matches || deNoche();
        window.matchMedia = (consulta) => (String(consulta).replace(/\s/g, '') === '(prefers-color-scheme:dark)'
          ? { media: consulta, get matches() { return afueraOscuro(); }, onchange: null, addEventListener() {}, removeEventListener() {}, addListener() {}, removeListener() {} }
          : original(consulta));

        const eleccion = () => { const v = localStorage.getItem('color_scheme'); return v === 'light' || v === 'dark' ? v : 'auto'; };
        const oscuro = () => eleccion() === 'dark' || (eleccion() === 'auto' && afueraOscuro());
        // Botón al final de la fila del logo de la barra lateral (en el celular, arriba del menú), con las clases del botón «redactar» de
        // Chatwoot, que queda justo debajo: mismo tamaño y mismo ícono de 14 px (p-0 quita el relleno que Chatwoot les da a los botones).
        // El ícono muestra el modo al que se pasa; lo elegido queda guardado igual que si se eligiera en Cambiar apariencia.
        const BOTON = 'inline-flex items-center justify-center flex-shrink-0 h-7 w-8 p-0 rounded-lg border-0 outline outline-1 outline-n-weak bg-n-button-color text-n-slate-11 text-sm transition-all duration-100 ease-out hover:enabled:bg-n-alpha-2 focus-visible:bg-n-alpha-2 dark:hover:enabled:bg-n-solid-2 dark:focus-visible:bg-n-solid-2 active:enabled:scale-[0.97]';
        function pintar() {
          const boton = document.getElementById('sh-tema');
          if (!boton) return;
          const o = document.body.classList.contains('dark');
          const accion = o ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro';
          boton.firstElementChild.className = (o ? 'i-lucide-sun' : 'i-lucide-moon') + ' flex-shrink-0';
          boton.setAttribute('aria-label', accion);
          boton.title = accion + (eleccion() === 'auto' ? '. Ahora cambia solo: claro de día, oscuro de noche.' : '. Quedó fijo; para que vuelva a cambiar solo: menú del perfil › Cambiar apariencia › Automático.');
        }
        // Lo mismo que hace Chatwoot al aplicar el tema
        function aplicar() {
          if (!document.body) return;
          document.body.classList.toggle('dark', oscuro());
          document.documentElement.style.setProperty('color-scheme', oscuro() ? 'dark' : 'light');
          pintar();
        }
        function botonTema() {
          const fila = document.querySelector('#app aside > section > div');
          if (!fila || fila.querySelector('#sh-tema')) return;
          const boton = document.createElement('button');
          boton.id = 'sh-tema';
          boton.type = 'button';
          boton.className = BOTON;
          boton.innerHTML = '<span aria-hidden="true"></span>';
          boton.addEventListener('click', () => {
            localStorage.setItem('color_scheme', document.body.classList.contains('dark') ? 'light' : 'dark');
            localStorage.setItem('color_scheme:ts', String(Date.now())); // como lo guarda Chatwoot
            aplicar();
          });
          fila.appendChild(boton);
          pintar();
        }
        function iniciar() {
          aplicar();
          new MutationObserver(pintar).observe(document.body, { attributes: true, attributeFilter: ['class'] }); // Cambiar apariencia
          setInterval(botonTema, 600);
        }
        if (document.body) iniciar(); else document.addEventListener('DOMContentLoaded', iniciar);
        equipo.addEventListener('change', aplicar);
        window.addEventListener('storage', (e) => { if (e.key === 'color_scheme') aplicar(); }); // lo elegido en otra pestaña
        document.addEventListener('visibilitychange', aplicar); // al volver a la pestaña: el computador pudo haber dormido
        setInterval(aplicar, 60000); // el amanecer y el atardecer

        // En Cambiar apariencia, «Sistema» es este modo automático: se renombra en los textos de Chatwoot (vue-i18n), no en la página. Si una
        // versión nueva de Chatwoot no lo deja, queda «Sistema» y todo lo demás funciona igual.
        const renombrar = setInterval(() => {
          const app = document.getElementById('app')?.__vue_app__;
          if (!app) return;
          clearInterval(renombrar);
          const p = app._context?.provides || {};
          const i18n = Object.getOwnPropertySymbols(p).map((s) => p[s]).find((v) => typeof v?.global?.mergeLocaleMessage === 'function');
          i18n?.global.mergeLocaleMessage('es', { COMMAND_BAR: { COMMANDS: { SYSTEM_MODE: 'Automático: claro de día, oscuro de noche' } } });
        }, 500);
      })();

      // Lanzador de campañas y de plantillas sueltas (campanas.html), en una ventana encima de Chatwoot. «extra» agrega parámetros: el botón
      // «Enviar plantilla» de una conversación pasa &conv=ID.
      (function() {
        window.shAbrirLanzador = (extra = '') => {
          if (document.querySelector('.sh-lanzador')) return;
          const csrf = document.querySelector('meta[name="csrf-token"]')?.content || '';
          const cuenta = (window.location.pathname.match(/\/accounts\/(\d+)/) || [])[1] || '1';
          const capa = document.createElement('div');
          capa.className = 'sh-lanzador';
          capa.innerHTML = '<div class="sh-lanzador__panel" role="dialog" aria-modal="true" aria-label="Lanzador de Sin Huellas">'
            + '<button type="button" class="sh-lanzador__cerrar" aria-label="Cerrar">✕</button>'
            + '<iframe class="sh-lanzador__marco" title="Lanzador de Sin Huellas"></iframe></div>';
          // Chatwoot sirve /public con caché de un año: «v» cambia sola con el contenido, así cada cambio del lanzador llega al navegador
          capa.querySelector('iframe').src = '/campanas.html?v=<%= (Digest::MD5.file(Rails.public_path.join('campanas.html')).hexdigest[0, 12] rescue '0') %>&csrf=' + encodeURIComponent(csrf) + '&acc=' + cuenta + '&n8n=' + encodeURIComponent('<%= ENV.fetch("SH_N8N_URL_PUBLICA", "") %>') + extra;
          const alEscape = (e) => { if (e.key === 'Escape') cerrar(); };
          const cerrar = () => { capa.remove(); document.removeEventListener('keydown', alEscape); };
          capa.querySelector('.sh-lanzador__cerrar').addEventListener('click', cerrar);
          document.addEventListener('keydown', alEscape);
          document.body.appendChild(capa);
          capa.querySelector('.sh-lanzador__cerrar').focus();
        };
        // el lanzador pide cerrarse después de enviar una plantilla suelta
        window.addEventListener('message', (e) => {
          if (e.origin === window.location.origin && e.data && e.data.sh === 'cerrar-lanzador') document.querySelector('.sh-lanzador')?.remove();
        });

        // Botón «Envío masivo» en las páginas de Campañas, con las clases de Tailwind de los botones de Chatwoot: en el celular flota abajo a la
        // derecha (el menú de Chatwoot flota a la izquierda) y desde 768 px va en el encabezado, junto a «Crear campaña». Si la página no tiene
        // ese encabezado, flota siempre.
        const ENVIO_MASIVO = 'fixed bottom-4 right-4 z-30 ms-auto inline-flex items-center justify-center gap-2 h-9 px-3 rounded-lg border-0 outline outline-1 outline-transparent bg-n-brand text-white text-sm font-medium shadow transition-all duration-100 ease-out hover:enabled:brightness-110 focus-visible:brightness-110 active:enabled:scale-[0.97]';
        function botonEnvioMasivo() {
          const enCampanas = window.location.pathname.includes('/campaigns');
          let boton = document.getElementById('sh-envio-masivo');
          if (!enCampanas) { boton?.remove(); return; }
          const crear = document.querySelector('[class~="group/campaign-button"]');
          if (boton && (crear ? boton.nextElementSibling === crear : boton.isConnected)) return;
          if (!boton) {
            boton = document.createElement('button');
            boton.id = 'sh-envio-masivo';
            boton.type = 'button';
            boton.innerHTML = '<span aria-hidden="true">⚡</span>Envío masivo';
            boton.addEventListener('click', () => window.shAbrirLanzador());
          }
          boton.className = crear ? `${ENVIO_MASIVO} md:static` : ENVIO_MASIVO;
          if (crear) crear.parentElement.insertBefore(boton, crear); else document.body.appendChild(boton);
        }
        setInterval(botonEnvioMasivo, 500);
      })();

      // Botón «Enviar plantilla» en las conversaciones de WhatsApp: en la caja de respuesta y en el aviso de las 24 horas. Abre el lanzador para
      // esa conversación, con la vista previa fiel y el archivo de la carpeta, del computador o de un enlace, revisado antes de enviar.
      (function() {
        const deWhatsapp = {}; // conversación → true si es de una bandeja de WhatsApp
        const actual = () => window.location.pathname.match(/\/accounts\/(\d+)\/(?:.*\/)?conversations\/(\d+)/);
        const abrir = () => { const m = actual(); if (m) window.shAbrirLanzador('&conv=' + m[2]); };
        // Las clases de Tailwind de los botones de Chatwoot: el de marca en la caja de respuesta (en el celular solo el ícono, para no empujar
        // el botón de enviar) y el de contorno en el aviso de las 24 horas. La clase sh-plantilla solo sirve para encontrarlos.
        const EN_CAJA = 'sh-plantilla inline-flex items-center justify-center min-w-0 gap-2 h-8 px-2.5 rounded-lg border-0 outline outline-1 outline-transparent bg-n-brand text-white text-sm transition-all duration-100 ease-out hover:enabled:brightness-110 focus-visible:brightness-110 active:enabled:scale-[0.97]';
        const EN_AVISO = 'sh-plantilla inline-flex items-center justify-center min-w-0 gap-2 h-8 px-3 rounded-lg border-0 outline outline-1 outline-n-container bg-n-button-color text-n-slate-12 text-sm font-medium transition-all duration-100 ease-out hover:enabled:bg-n-alpha-2 focus-visible:bg-n-alpha-2';
        function boton(enAviso) {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = enAviso ? EN_AVISO : EN_CAJA;
          b.title = 'Enviar una plantilla de WhatsApp';
          if (enAviso) b.textContent = 'Elegir plantilla';
          else {
            b.setAttribute('aria-label', 'Enviar plantilla');
            b.innerHTML = '<span aria-hidden="true">📨</span><span class="hidden sm:inline">Enviar plantilla</span>';
          }
          b.addEventListener('click', abrir);
          return b;
        }
        function revisar() {
          const m = actual();
          const conv = m && m[2];
          if (conv && !(conv in deWhatsapp)) {
            deWhatsapp[conv] = null;
            let s = {};
            try { s = JSON.parse(decodeURIComponent((document.cookie.match(/cw_d_session_info=([^;]+)/) || [])[1] || '{}')); } catch (e) { /* sin sesión */ }
            fetch('/api/v1/accounts/' + m[1] + '/conversations/' + conv, { headers: { 'access-token': s['access-token'] || '', client: s.client || '', uid: s.uid || '' } })
              .then((r) => r.json()).then((c) => { deWhatsapp[conv] = (c.meta && c.meta.channel) === 'Channel::Whatsapp'; })
              .catch(() => { delete deWhatsapp[conv]; });
          }
          if (!conv || !deWhatsapp[conv]) { document.querySelectorAll('.sh-plantilla').forEach((b) => b.remove()); return; }
          const barra = document.querySelector('.reply-box .left-wrap');
          if (barra && !barra.querySelector('.sh-plantilla')) barra.appendChild(boton(false));
          const aviso = [...document.querySelectorAll('.woot-banner')].find((x) => /24/.test(x.textContent));
          if (aviso && !aviso.querySelector('.sh-plantilla')) aviso.appendChild(boton(true));
        }
        setInterval(revisar, 600);
      })();
    </script>
  </head>
  <body class="text-slate-600">
    <div id="app"></div>
    <noscript id="noscript">This app works best with JavaScript enabled.</noscript>
    <%= yield %>
    <% if @dashboard_scripts.present? %>
      <%= @dashboard_scripts.html_safe %>
    <% end %>
  </body>
</html>
