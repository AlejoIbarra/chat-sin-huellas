<!DOCTYPE html>
<html>
  <head>
    <title>
      <%= @global_config['INSTALLATION_NAME'] %>
    </title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no, user-scalable=0"/>
    <% unless ChatwootApp.chatwoot_cloud? %>
      <meta name="robots" content="noindex">
    <% end %>
    <% if @global_config['DISPLAY_MANIFEST'] %>
      <meta name="msapplication-TileColor" content="#2781F6">
      <meta name="msapplication-TileImage" content="/ms-icon-144x144.png">
      <meta name="theme-color" content="#2781F6">
      <meta name="description" content="<%= @global_config['INSTALLATION_NAME'] %> is a customer support solution that helps companies engage customers over Messenger, Twitter, Telegram, WeChat, Whatsapp. Simply connect your channels and converse with your customers from a single place. Easily add new agents to your system and have them own and resolve conversations with customers. <%= @global_config['INSTALLATION_NAME'] %> also gives you real-time reports to measure your team's performance, canned responses to easily respond to frequently asked questions and private notes for agents to collaborate among themselves.">
      <% if ENV['IOS_APP_IDENTIFIER'].present? %>
        <meta name="apple-itunes-app" content='app-id=<%= ENV['IOS_APP_IDENTIFIER'] %>'>
      <% end %>
      <link rel="apple-touch-icon" sizes="57x57" href="/apple-icon-57x57.png">
      <link rel="apple-touch-icon" sizes="60x60" href="/apple-icon-60x60.png">
      <link rel="apple-touch-icon" sizes="72x72" href="/apple-icon-72x72.png">
      <link rel="apple-touch-icon" sizes="76x76" href="/apple-icon-76x76.png">
      <link rel="apple-touch-icon" sizes="114x114" href="/apple-icon-114x114.png">
      <link rel="apple-touch-icon" sizes="120x120" href="/apple-icon-120x120.png">
      <link rel="apple-touch-icon" sizes="144x144" href="/apple-icon-144x144.png">
      <link rel="apple-touch-icon" sizes="152x152" href="/apple-icon-152x152.png">
      <link rel="apple-touch-icon" sizes="180x180" href="/apple-icon-180x180.png">
      <link rel="icon" type="image/png" sizes="192x192"  href="/android-icon-192x192.png">
      <link class="favicon" rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
      <link class="favicon" rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
      <link class="favicon" rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
      <link rel="manifest" href="/manifest.json">
    <% end %>
    <link rel="icon" type="image/png" sizes="512x512" href="<%= @global_config['LOGO_THUMBNAIL'] %>">
    <%= csrf_meta_tags %>
    <script>
      window.chatwootConfig = {
        hostURL: '<%= ENV.fetch('FRONTEND_URL', '') %>',
        helpCenterURL: '<%= ENV.fetch('HELPCENTER_URL', '') %>',
        fbAppId: '<%= @global_config['FB_APP_ID'] %>',
        instagramAppId: '<%= @global_config['INSTAGRAM_APP_ID'] %>',
        tiktokAppId: '<%= @global_config['TIKTOK_APP_ID'] %>',
        googleOAuthClientId: '<%= ENV.fetch('GOOGLE_OAUTH_CLIENT_ID', nil) %>',
        googleOAuthCallbackUrl: '<%= ENV.fetch('GOOGLE_OAUTH_CALLBACK_URL', nil) %>',
        allowedLoginMethods: <%= @global_config['ALLOWED_LOGIN_METHODS'].to_json.html_safe %>,
        fbApiVersion: '<%= @global_config['FACEBOOK_API_VERSION'] %>',
        whatsappAppId: '<%= @global_config['WHATSAPP_APP_ID'] %>',
        whatsappConfigurationId: '<%= @global_config['WHATSAPP_CONFIGURATION_ID'] %>',
        whatsappApiVersion: '<%= @global_config['WHATSAPP_API_VERSION'] %>',
        signupEnabled: '<%= @global_config['ENABLE_ACCOUNT_SIGNUP'] %>',
        isEnterprise: '<%= @global_config['IS_ENTERPRISE'] %>',
        isMfaEnabled: '<%= Chatwoot.mfa_enabled? %>',
        <% if @global_config['IS_ENTERPRISE'] %>
        enterprisePlanName: '<%= @global_config['INSTALLATION_PRICING_PLAN'] %>',
        <% end %>
        <% if @global_config['VAPID_PUBLIC_KEY'] %>
        vapidPublicKey: new Uint8Array(<%= Base64.urlsafe_decode64(@global_config['VAPID_PUBLIC_KEY']).bytes %>),
        <% end %>
        enabledLanguages: <%= available_locales_with_name.to_json.html_safe %>,
        helpUrls: <%= feature_help_urls.to_json.html_safe %>,
        inboxEventsEnabled: '<%= ENV['ENABLE_INBOX_EVENTS'].present? %>',
        selectedLocale: '<%= I18n.locale %>'
      }
      window.globalConfig = <%= raw @global_config.merge("LOGO" => "#{@global_config["LOGO"]}?v=1", "LOGO_DARK" => "#{@global_config["LOGO_DARK"]}?v=1", "LOGO_THUMBNAIL" => "#{@global_config["LOGO_THUMBNAIL"]}?v=1").to_json %>
      window.browserConfig = {
        browser_name: '<%= browser.name %>',
      }
      window.errorLoggingConfig = '<%= ENV.fetch('SENTRY_FRONTEND_DSN', '') || ENV.fetch('SENTRY_DSN', '') %>'
    </script>
    <% if @global_config['CLOUD_ANALYTICS_TOKEN'].present? %>
    <script>
      window.analyticsConfig = {
        token: '<%= @global_config['CLOUD_ANALYTICS_TOKEN'] %>',
      }
    </script>
    <% end %>
    <%= vite_client_tag %>
    <%= vite_javascript_tag @application_pack %>
    <link rel="stylesheet" id="sinhuellas-custom-css" href="/custom.css?v=1791347814$(date +%s)<%= Time.now.to_i %>">
    <script>
      (function() {
        function ensureCustomCssLast() {
          var link = document.getElementById('sinhuellas-custom-css');
          if (link && document.head && document.head.lastElementChild !== link) document.head.appendChild(link);
        }
        function replaceTexts() {
          if (document.title && document.title.includes('Chatwoot')) document.title = document.title.replace(/Chatwoot/g, 'Chat sin huellas');
          var walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, null, false);
          var node;
          while (node = walker.nextNode()) {
            if (node.nodeValue.includes('Iniciar sesión en Chatwoot')) {
              node.nodeValue = node.nodeValue.replace(/Iniciar sesión en Chatwoot/g, 'Iniciar sesión en Chat sin huellas');
            }
            // El estado «Pendientes» es donde atiende el bot: el equipo lo ve con ese nombre (solo el texto exacto, en el menú de estado y su etiqueta)
            if (node.nodeValue.trim() === 'Pendientes') node.nodeValue = 'Bot atendiendo';
          }
        }
        document.addEventListener('DOMContentLoaded', ensureCustomCssLast);
        window.addEventListener('load', ensureCustomCssLast);
        setTimeout(ensureCustomCssLast, 1000);
        setInterval(replaceTexts, 100);
      })();

      // Injection script for Massive Campaigns Express Button
      (function() {
        // Abre el lanzador encima de Chatwoot; «extra» agrega parámetros (el botón «Enviar plantilla» de una conversación pasa &conv=ID)
        window.shAbrirLanzador = (extra = '') => {
              const csrfMeta = document.querySelector('meta[name="csrf-token"]');
              const csrfToken = csrfMeta ? csrfMeta.content : '';
              const match = window.location.pathname.match(/\/accounts\/(\d+)/);
              const accountId = match ? match[1] : '1';

              const overlay = document.createElement('div');
              overlay.id = 'sh-mass-campaign-overlay';
              overlay.style.cssText = 'position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 9999999; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(4px);';

              const modal = document.createElement('div');
              modal.style.cssText = 'width: 90%; max-width: 900px; height: 85vh; background: white; border-radius: 1rem; overflow: hidden; position: relative; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);';

              const closeBtn = document.createElement('button');
              closeBtn.innerHTML = '✕';
              closeBtn.style.cssText = 'position: absolute; top: 1rem; right: 1rem; background: #f1f5f9; border: none; border-radius: 50%; width: 32px; height: 32px; font-weight: bold; cursor: pointer; color: #475569; z-index: 10; display:flex; align-items:center; justify-content:center; font-size:16px;';
              closeBtn.onclick = () => document.body.removeChild(overlay);

              const iframe = document.createElement('iframe');
              // Chatwoot sirve /public con caché de un año: «v» cambia sola con el contenido, así cada cambio del lanzador llega al navegador
              iframe.src = '/campanas.html?v=<%= (Digest::MD5.file(Rails.public_path.join('campanas.html')).hexdigest[0, 12] rescue '0') %>&csrf=' + encodeURIComponent(csrfToken) + '&acc=' + accountId + '&n8n=' + encodeURIComponent('<%= ENV.fetch("SH_N8N_URL_PUBLICA", "") %>') + extra;
              iframe.style.cssText = 'width: 100%; height: 100%; border: none; background: transparent;';

              modal.appendChild(closeBtn);
              modal.appendChild(iframe);
              overlay.appendChild(modal);
              document.body.appendChild(overlay);
        };
        // el lanzador pide cerrarse después de enviar una plantilla suelta
        window.addEventListener('message', (e) => {
          if (e.origin === window.location.origin && e.data && e.data.sh === 'cerrar-lanzador') document.getElementById('sh-mass-campaign-overlay')?.remove();
        });

        function manageCampaignButton() {
          const btnId = 'sh-mass-campaign-btn';
          let btn = document.getElementById(btnId);
          const isCampaignsPage = window.location.pathname.includes('/campaigns');
          
          if (isCampaignsPage && !btn) {
            btn = document.createElement('button');
            btn.id = btnId;
            btn.innerText = '⚡️ Envío Masivo Express';
            btn.style.cssText = 'position: fixed; top: 18px; right: 280px; z-index: 999999; background: #163f30; color: white; padding: 0.5rem 1.25rem; border-radius: 999px; font-weight: 700; cursor: pointer; border: 1px solid rgba(255,255,255,0.2); font-size: 14px; box-shadow: 0 10px 15px -3px rgba(22,63,48,0.4); transition: all 0.2s;'; btn.onmouseover = () => btn.style.transform = 'translateY(-2px)'; btn.onmouseout = () => btn.style.transform = 'translateY(0)';
            
            btn.onclick = () => window.shAbrirLanzador();
            
            document.body.appendChild(btn);
          } else if (!isCampaignsPage && btn) {
            btn.remove();
          }
        }

        setInterval(manageCampaignButton, 500);
      })();

      // Botón «Enviar plantilla» en las conversaciones de WhatsApp (en la caja de respuesta y en el aviso de las 24 horas): abre el lanzador para esa
      // conversación, con la vista previa fiel y el archivo de la carpeta, del computador o de un enlace, revisado antes de enviar. El ícono de plantillas
      // propio de Chatwoot se esconde: pide la dirección del archivo a mano, no la revisa y, si Meta no puede usarla, el mensaje falla minutos después.
      (function() {
        const estilo = document.createElement('style');
        estilo.textContent = '.left-wrap > button:has(.i-ph-whatsapp-logo){display:none!important}'
          + '.sh-plantilla{display:inline-flex;align-items:center;gap:6px;height:32px;padding:0 12px;margin-left:4px;border-radius:8px;border:1px solid #d7a944;background:#163f30;color:#fff;font-size:13px;font-weight:600;cursor:pointer;white-space:nowrap}'
          + '.sh-plantilla:hover{filter:brightness(1.2)}'
          + '.woot-banner .sh-plantilla{height:28px;background:#fff;color:#163f30;border-color:#fff}';
        document.head.appendChild(estilo);
        const deWhatsapp = {}; // conversación → true si es de una bandeja de WhatsApp
        const actual = () => window.location.pathname.match(/\/accounts\/(\d+)\/(?:.*\/)?conversations\/(\d+)/);
        const abrir = () => { const m = actual(); if (m) window.shAbrirLanzador('&conv=' + m[2]); };
        const boton = (texto) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'sh-plantilla'; b.textContent = texto; b.onclick = abrir; return b; };
        function revisar() {
          const m = actual();
          const conv = m && m[2];
          if (conv && !(conv in deWhatsapp)) {
            deWhatsapp[conv] = null;
            let s = {};
            try { s = JSON.parse(decodeURIComponent((document.cookie.match(/cw_d_session_info=([^;]+)/) || [])[1] || '{}')); } catch (e) { /* sin sesión */ }
            fetch('/api/v1/accounts/' + m[1] + '/conversations/' + conv, { headers: { 'access-token': s['access-token'] || '', client: s.client || '', uid: s.uid || '' } })
              .then((r) => r.json()).then((c) => { deWhatsapp[conv] = (c.meta && c.meta.channel) === 'Channel::Whatsapp'; })
              .catch(() => { delete deWhatsapp[conv]; });
          }
          if (!conv || !deWhatsapp[conv]) { document.querySelectorAll('.sh-plantilla').forEach((b) => b.remove()); return; }
          const barra = document.querySelector('.reply-box .left-wrap');
          if (barra && !barra.querySelector('.sh-plantilla')) barra.appendChild(boton('📨 Enviar plantilla'));
          const aviso = [...document.querySelectorAll('.woot-banner')].find((x) => /24/.test(x.textContent));
          if (aviso && !aviso.querySelector('.sh-plantilla')) aviso.appendChild(boton('Elegir plantilla'));
        }
        setInterval(revisar, 600);
      })();
    </script>
  </head>
  <body class="text-slate-600">
    <div id="app"></div>
    <noscript id="noscript">This app works best with JavaScript enabled.</noscript>
    <%= yield %>
    <% if @dashboard_scripts.present? %>
      <%= @dashboard_scripts.html_safe %>
    <% end %>
  </body>
</html>
